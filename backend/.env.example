# ==============================================================================
# TripPlanner 运行时环境配置示例模板 (backend/.env.example)
# ==============================================================================
# 使用方法:
#   cp backend/.env.example backend/.env
#   并在 backend/.env 中填入你的真实密钥（注意：.env 文件已被 .gitignore 拦截）
# ==============================================================================

# 1. 大语言模型配置 (LLM Configuration)
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL_ID=glm-5.3-flash
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/plan
LLM_PROTOCOL=anthropic

# 2. 高德地图 Web 服务 Key
AMAP_API_KEY=your_amap_web_service_key_here

# 3. Tavily 实时搜索 Key
TAVILY_API_KEY=your_tavily_api_key_here

# 4. Redis 缓存服务
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_ENABLED=true

# 5. 服务配置
HOST=0.0.0.0
PORT=8000
